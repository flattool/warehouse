using Gtk 4.0;
using Adw 1;

$ArrayStore installations {}

FilterListModel remotes_list {
	filter: CustomFilter only_remotes_filter {};

	model: FlattenListModel {
		model: MapListModel map_remotes_model {
			model: installations;
		};
	};
}

FilterListModel packages_list {
	filter: CustomFilter only_packages_filter {};

	model: FlattenListModel {
		model: MapListModel map_packages_model {
			model: installations;
		};
	};
}

template $MainWindow: Adw.ApplicationWindow {
	title: _("Warehouse");
	default-width: 1045;
	default-height: 570;
	width-request: 390;

	Adw.Breakpoint {
		condition ("max-width: 950")

		setters {
			split_view.collapsed: true;
		}
	}

	content: Adw.ToastOverlay toast_overlay {
		child: Adw.OverlaySplitView split_view {
			sidebar: Adw.ToolbarView {
				[top]
				Adw.HeaderBar header_bar {
					[start]
					Button {
						label: _("Test");
						clicked => $_do_test();
					}

					[end]
					MenuButton {
						primary: true;
						icon-name: "open-menu-symbolic";
						tooltip-text: _("Main Menu");
						menu-model: primary_menu;
					}
				}

				content: Adw.ViewSwitcherSidebar {
					stack: view_stack;
					activated => $_on_row_chosen();
				};
			};

			content: Adw.ViewStack view_stack {
				Adw.ViewStackPage {
					child: $PackagesPage packages_page {
						installations: installations;
						packages: packages_list;
						remotes: remotes_list;
						loading: bind template.loading;
					};

					icon-name: bind packages_page.icon_name;
					title: bind packages_page.sidebar_title;
				}

				Adw.ViewStackPage {
					child: $RemotesPage remotes_page {
						installations: installations;
						packages: packages_list;
						remotes: remotes_list;
						loading: bind template.loading;
					};

					icon-name: bind remotes_page.icon_name;
					title: bind remotes_page.sidebar_title;
				}

				Adw.ViewStackPage {
					child: $DataPage data_page {
						installations: installations;
						packages: packages_list;
						remotes: remotes_list;
						loading: bind template.loading;
					};

					icon-name: bind data_page.icon_name;
					title: bind data_page.sidebar_title;
				}

				Adw.ViewStackPage {
					child: $InstallationsPage installations_page {
						installations: installations;
						packages: packages_list;
						remotes: remotes_list;
						loading: bind template.loading;
					};

					icon-name: bind installations_page.icon_name;
					title: bind installations_page.sidebar_title;
				}
			};
		};
	};
}

menu primary_menu {
	section {
		item (_("_Preferences"), "app.preferences")
		item (_("Keyboard Shortcuts"), "app.shortcuts")
		item (_("_About Warehouse"), "app.about")
	}
}
