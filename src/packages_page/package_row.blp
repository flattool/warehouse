using Gtk 4.0;

template $PackageRow: Box {
	spacing: 12;
	margin-start: 9;
	margin-end: 9;

	Image app_icon {
		icon-size: large;
		paintable: bind template.flatpak as <$Package>.icon_paintable;

		styles [
			"icon-dropshadow",
		]
	}

	Box {
		orientation: vertical;
		hexpand: true;
		margin-top: 9;
		margin-bottom: 9;

		Label title_label {
			halign: start;
			label: bind template.flatpak as <$Package>.title;
		}

		Label subtitle_label {
			halign: start;
			label: bind template.flatpak as <$Package>.application;

			styles [
				"subtitle",
			]
		}
	}
}

