using Gtk 4.0;
using Adw 1;

FilterListModel filtered_packages_list {
	filter: AnyFilter {
		StringFilter {
			expression: expr item as <$Package>.title;
			search: bind template.search_text;
		}

		StringFilter {
			expression: expr item as <$Package>.application;
			search: bind template.search_text;
		}
	};

	model: SortListModel sorted_packages_list {
		sorter: StringSorter {
			expression: expr item as <$Package>.title;
		};

		model: FilterListModel {
			model: bind template.packages;

			filter: BoolFilter {
				expression: expr $_show_package_by_runtime(item as <$Package>.is_runtime, template.show_runtimes) as <bool>;
			};
		};
	};
}

template $PackagesPage: $BasePage {
	title: bind $_get_title(template.show_runtimes) as <string>;
	sidebar_title: bind $_get_sidebar_title(template.show_runtimes) as <string>;
	icon_name: bind $_get_icon_name(template.show_runtimes) as <string>;

	child: Adw.BreakpointBin {
		width-request: 1;
		height-request: 1;

		Adw.Breakpoint {
			condition ("max-width: 600")

			setters {
				split_view.collapsed: true;
			}
		}

		child: Stack {
			visible-child-name: bind $_get_visible_page(template.loading, sorted_packages_list.n-items) as <string>;

			StackPage loading_page {
				name: "loading_page";

				child: Adw.ToolbarView {
					[top]
					Adw.HeaderBar {
						[start]
						$SidebarButton {}
					}

					content: Adw.StatusPage {
						title: _("Loading Packages");
						description: _("This should only take a moment.");

						paintable: Adw.SpinnerPaintable {
							widget: template;
						};
					};
				};
			}

			StackPage no_packages_page {
				name: "no_packages_page";

				child: Adw.ToolbarView {
					[top]
					Adw.HeaderBar {
						[start]
						$SidebarButton {}
					}

					content: Adw.StatusPage {
						icon-name: "warehouse:error-symbolic";
						title: _("No Packages Found");
						description: _("Warehouse cannot see the list of installed packages or your system has no packages installed");
					};
				};
			}

			StackPage content_page {
				name: "content_page";

				child: Adw.NavigationSplitView split_view {
					sidebar-width-fraction: 0.5;
					max-sidebar-width: 999999999.0;

					sidebar: Adw.NavigationPage {
						title: bind template.title;

						child: Adw.BottomSheet bottom_sheet {
							reveal-bottom-bar: bind $_should_show_bottom_bar(template.in_selection_mode, sorted_packages_list.n-items) as <bool>;
							// styles [
							// 	"margined-bottom-sheet",
							// ]

							[content]
							Adw.ToolbarView {
								[top]
								Adw.HeaderBar {
									[start]
									$SidebarButton {}

									[start]
									$SearchButton search_button {
										sensitive: bind $_has_any_packages(sorted_packages_list.n-items) as <bool>;
									}

									[end]
									ToggleButton {
										tooltip-text: _("Select Packages");
										icon-name: "warehouse:selection-mode-symbolic";
										sensitive: bind $_has_any_packages(sorted_packages_list.n-items) as <bool>;
										active: bind template.in_selection_mode bidirectional;
									}
								}

								[top]
								Adw.Clamp {
									child: SearchBar {
										key-capture-widget: template;
										search-mode-enabled: bind search_button.active bidirectional;

										child: SearchEntry search_enty {
											hexpand: true;
											placeholder-text: _("Search Packages");
											search-changed => $_on_search_changed();
										};
									};
								}

								content: $SearchGroup {
									no_results: bind $_has_no_packages(filtered_packages_list.n-items) as <bool>;

									content: ScrolledWindow scrolled_window {
										styles [
											"scrollbar-offset",
										]

										child: Box {
											orientation: vertical;

											ListBox list_box {
												row-selected => $_on_row_selected();
												row-activated => $_on_row_activated();

												styles [
													"navigation-sidebar",
												]
											}

											Adw.Bin {
												height-request: bind bottom_sheet.bottom-bar-height;
											}
										};
									};
								};

								[bottom]
								Revealer {
									reveal-child: bind template.in_selection_mode;

									child: ActionBar {
										Button {
											label: _("Action Button");
										}
									};
								}
							}

							[sheet]
							$FilterPage filter-page {}

							[bottom-bar]
							Box {
								spacing: 12;
								margin-top: 14;
								margin-bottom: 14;
								margin-start: 16;
								margin-end: 16;

								Image {
									icon-name: "warehouse:funnel-outline-symbolic";
								}

								Label {
									label: _("Set Filters");
									ellipsize: end;
									hexpand: true;
									halign: start;

									styles [
										"heading",
									]
								}

								Label {
									label: "Showing 98 / 107";
									ellipsize: middle;
									hexpand: true;
									halign: end;

									styles [
										"heading",
									]
								}
							}
						};
					};

					content: $DetailsPage details_page {};
				};
			}
		};
	};
}
