using Gtk 4.0;
using Adw 1;

template $InstallationRow: Adw.ActionRow {
	title: bind template.installation as <$Installation>.title;
	subtitle: bind template.installation as <$Installation>.name;

	[suffix]
	Label {
		label: bind template.installation as <$Installation>.location_path;
		margin-end: 6;
		wrap: true;
		wrap-mode: word_char;
		natural-wrap-mode: none;
		halign: end;
		hexpand: true;
		justify: right;

		styles [
			"subtitle",
		]
	}

	[suffix]
	MenuButton {
		icon-name: "warehouse:info-outline-symbolic";
		visible: bind $_is_other_installation(template.installation as <$Installation>.location_tag) as <bool>;
		tooltip-text: _("Custom installation...");
		popover: custom_installation_popover;
		valign: center;

		styles [
			"flat",
		]
	}

	[suffix]
	MenuButton more_menu {
		valign: center;
		icon-name: "warehouse:view-more-symbolic";
		tooltip-text: _("More Actions");

		styles [
			"flat",
		]
	}
}

Popover custom_installation_popover {
	child: Label {
		label: _("Custom installations allow for Flatpaks to be installed in other locations.");
		wrap: true;
		wrap-mode: word;
		max-width-chars: 52;
		margin-start: 6;
		margin-end: 6;
		margin-top: 6;
		margin-bottom: 6;
	};
}

$SimpleMenu {
	menu_button: more_menu;

	$SimpleMenuItem {
		label: _("Copy Title");
		chosen => $_copy_title();
	}

	$SimpleMenuItem {
		label: _("Copy Name");
		chosen => $_copy_name();
	}

	$SimpleMenuItem {
		label: _("Copy Installation Location");
		chosen => $_copy_path();
	}

	$SimpleMenuItem {
		label: _("Open Installation Folder");
		chosen => $_open_path();
	}

	$SimpleMenuItem {
		label: _("Remove");
		visible: bind $_is_other_installation(template.installation as <$Installation>.location_tag) as <bool>;
		chosen => $_remove();
	}
}
