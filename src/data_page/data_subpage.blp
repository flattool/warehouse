using Gtk 4.0;
using Adw 1;

FilterListModel searched_folders {
	filter: CustomFilter search_filter {};

	model: bind template.folders;
}

template $DataSubpage: Adw.BreakpointBin {
	width-request: 1;
	height-request: 1;

	Adw.Breakpoint {
		condition ("max-width: 550")

		setters {
			header_box.orientation: vertical;
			size_label.justify: left;
			selection_label.justify: left;
		}
	}

	child: $SearchGroup {
		no_results: bind $_get_no_results(template.search_text, searched_folders.n-items) as <bool>;

		content: Box {
			orientation: vertical;

			Box header_box {
				margin-start: 24;
				margin-end: 24;
				margin-bottom: 9;
				spacing: 6;

				Label title {
					label: bind $_get_title(template.show_leftover) as <string>;
					halign: start;
					hexpand: true;
					wrap: true;

					styles [
						"title-1",
					]
				}

				Box size_box {
					Spinner spinner {
						spinning: bind spinner.visible;
						visible: bind $_is_size_unknown(template.size);
						valign: center;
						margin-end: 6;
					}

					Label size_label {
						visible: bind template.selection_mode_enabled inverted;
						label: bind $_get_readable_size(template.size);
						justify: right;

						styles [
							"title-4",
						]
					}

					Label selection_label {
						visible: bind template.selection_mode_enabled;
						label: bind template.selection_text;
						justify: right;

						styles [
							"title-4",
						]
					}
				}
			}

			ScrolledWindow scrolled_window {
				vexpand: true;

				child: Box {
					orientation: vertical;
					margin-start: 12;
					margin-end: 12;
					margin-bottom: 12;
					spacing: 12;

					Separator {
						orientation: horizontal;
					}

					FlowBox flow_box {
						selection-mode: none;
						column-spacing: 9;
						row-spacing: 9;
						homogeneous: true;

						styles [
							"card-flowbox",
						]
					}
				};
			}

			Revealer {
				reveal-child: bind template.selection_mode_enabled;
				transition-type: slide_up;

				child: Box {
					styles [
						"toolbar",
					]

					Button {
						label: _("One");
					}

					Button {
						label: _("Two");
					}
				};
			}
		};
	};
}
