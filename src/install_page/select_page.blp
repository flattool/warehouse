using Gtk 4.0;
using Adw 1;

MapListModel selectable_remotes {
	model: SortListModel {
		sorter: StringSorter {
			expression: expr item as <$Remote>.title;
		};

		model: FilterListModel {
			filter: BoolFilter {
				expression: expr item as <$Remote>.disabled;
				invert: true;
			};

			model: bind template.remotes;
		};
	};
}

SortListModel sorted_results {
	// sorter: StringSorter {
	// 	expression: expr item as <$SearchResult>.name;
	// };

	model: bind template.search_results;
}

template $SelectPage: Adw.Bin {
	child: Adw.ToolbarView {
		[top]
		Adw.HeaderBar {}

		[top]
		Box {
			margin-start: 6;
			margin-end: 6;

			styles [
				"linked",
			]

			SearchEntry search_entry {
				hexpand: true;
				placeholder-text: _("Search for New Packages");
				search-changed => $_search_changed();
			}

			DropDown remote_dropdown {
				tooltip-text: _("Choose a Remote");
				enable-search: true;
				hexpand: true;
				model: selectable_remotes;
				expression: expr item as <$SelectableRemote>.remote as <$Remote>.title;

				notify::selected-item => $_remote_selected();
			}
		}

		content: $LoadingGroup {
			is_loading: bind template.is_searching;
			title: _("Loading Results");

			// TODO: figure out the proper wording for this
			description: _("This can take a while.");

			content: Stack {
				visible-child-name: bind template.visible_stack_page;

				StackPage {
					name: "empty-search";

					child: Adw.StatusPage {
						icon-name: "warehouse:loupe-large-symbolic";
						title: _("Search for Packages");
						description: _("Search for packages to queue for installation.");
					};
				}

				StackPage {
					name: "results-list";

					child: Adw.Clamp {
						child: ScrolledWindow {
							child: ListBox results_box {
								margin-start: 12;
								margin-end: 12;
								margin-top: 12;
								margin-bottom: 12;
								selection-mode: none;

								styles [
									"boxed-list",
								]
							};
						};
					};
				}

				StackPage {
					name: "no-results";

					child: Adw.StatusPage {
						icon-name: "warehouse:loupe-large-symbolic";
						title: _("No Results Found");
						description: _("Try a different search.");
					};
				}
			};
		};
	};
}
