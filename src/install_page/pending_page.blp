using Gtk 4.0;
using Adw 1;

template $PendingPage: Adw.Bin {
	child: Adw.ToolbarView {
		[top]
		Adw.HeaderBar {}

		content: Stack {
			visible-child-name: bind $_get_stack_page(template.n_pending);

			StackPage {
				name: "none-pending";

				child: Adw.StatusPage {
					icon-name: "warehouse:flatpak-symbolic";
					title: _("Add Packages");
					description: _("Packages queued to install will show up here");
				};
			}

			StackPage {
				name: "some-pending";

				child: Adw.PreferencesPage group_page {};
			}
		};

		[bottom]
		ActionBar bar {
			revealed: bind $_show_install_button(template.n_pending);

			[center]
			Button {
				margin-top: 3;
				margin-bottom: 3;
				sensitive: bind bar.revealed;

				styles [
					"pill",
					"suggested-action",
				]

				child: Adw.ButtonContent {
					can-shrink: true;
					icon-name: "warehouse:arrow-pointing-at-line-down-symbolic";
					label: _("Install");
				};
			}
		}
	};
}
